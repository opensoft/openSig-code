  "cases": [
    {
      "id": "EC-ENV-01",
      "title": "create a draft envelope with one recipient",
      "given": null,
      "request": {
        "operationId": "createEnvelope",
        "body": {
          "json": {
            "source": {
              "app": "manual",
              "record": "synthetic-record-0001",
              "version": "v1"
            },
            "recipients": [
              {
                "email": "signer.one@example.test",
                "role": "approver",
                "ordinal": 1
              }
            ]
          }
        }
      },
      "defect": null,
      "expect": {
        "status": 201,
        "body": [
          {
            "path": "state",
            "equals": "draft"
          },
          {
            "path": "version",
            "equals": 1
          },
          {
            "path": "recipients",
            "length": 1
          },
          {
            "path": "recipients[0].ordinal",
            "equals": 1
          },
          {
            "path": "recipients[0].email",
            "equals": "signer.one@example.test"
          },
          {
            "path": "recipients[0].status",
            "equals": "pending"
          },
          {
            "path": "recipients[0].invited_at",
            "equals": null
          },
          {
            "path": "document",
            "equals": null
          },
          {
            "path": "manifest_digest",
            "equals": null
          },
          {
            "path": "approvals_complete",
            "equals": false
          },
          {
            "path": "created_by.kind",
            "equals": "human-operator"
          },
          {
            "path": "send_confirmation.required",
            "equals": false
          },
          {
            "path": "reissue_of",
            "equals": null
          },
          {
            "path": "artifact",
            "equals": null
          }
        ]
      },
      "basis": [
        {
          "pointer": "#/paths/~1v1~1envelopes/post/responses/201/description",
          "text": "recipient IDs are server-generated and returned with their ordinals"
        },
        {
          "pointer": "#/components/schemas/RecipientView/properties/status/description",
          "text": "pending = not yet its turn or not sent"
        },
        {
          "pointer": "#/components/schemas/Envelope/properties/send_confirmation/properties/required/description",
          "text": "True when created_by.kind is service"
        }
      ]
    },
