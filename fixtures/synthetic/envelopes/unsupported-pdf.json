    {
      "id": "EC-PDF-07",
      "title": "a page crop box that differs from its media box is rejected",
      "given": "draft-1",
      "request": {
        "operationId": "uploadDocument",
        "path": {
          "envelope_id": {
            "$ctx": "envelope_id"
          }
        },
        "body": {
          "pdf": {
            "pages": 1,
            "cropBox": [
              36,
              36,
              576,
              756
            ]
          }
        }
      },
      "defect": {
        "kind": "pdf-content",
        "feature": "cropbox-differs"
      },
      "expect": {
        "status": 422,
        "code": "unsupported_pdf",
        "detailCodes": [
          "cropbox_differs"
        ]
      },
      "basis": [
        {
          "pointer": "#/components/responses/Unprocessable/description",
          "text": "effective CropBox different from MediaBox [details code cropbox_differs]"
        }
      ]
    },
