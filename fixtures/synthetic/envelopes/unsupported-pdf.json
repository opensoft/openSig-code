    {
      "id": "EC-PDF-04",
      "title": "each page of a mixed-rotation PDF reports its own geometry",
      "given": "draft-1",
      "request": {
        "operationId": "uploadDocument",
        "path": {
          "envelope_id": {
            "$ctx": "envelope_id"
          }
        },
        "body": {
          "pdf": {
            "pages": 3,
            "rotate": [
              0,
              90,
              180
            ]
          }
        }
      },
      "defect": null,
      "expect": {
        "status": 200,
        "body": [
          {
            "path": "document.pages",
            "length": 3
          },
          {
            "path": "document.pages[0]",
            "equals": {
              "number": 1,
              "width": 612,
              "height": 792,
              "rotate": 0
            }
          },
          {
            "path": "document.pages[1]",
            "equals": {
              "number": 2,
              "width": 792,
              "height": 612,
              "rotate": 90
            }
          },
          {
            "path": "document.pages[2]",
            "equals": {
              "number": 3,
              "width": 612,
              "height": 792,
              "rotate": 180
            }
          }
        ]
      },
      "basis": [
        {
          "pointer": "#/components/schemas/PageGeometry/description",
          "text": "Displayed page size after applying /Rotate, in PDF points."
        }
      ]
    },
