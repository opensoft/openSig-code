{
  "schema": "opensig.envelope-conformance-fixture/1",
  "category": "unsupported-pdf",
  "cases": [
    {
      "id": "EC-PDF-01",
      "title": "a plain one-page PDF is accepted with its page geometry",
      "given": "draft-1",
      "request": {
        "operationId": "uploadDocument",
        "path": {
          "envelope_id": {
            "$ctx": "envelope_id"
          }
        },
        "body": {
          "pdf": {
            "pages": 1
          }
        }
      },
      "defect": null,
      "expect": {
        "status": 200,
        "body": [
          {
            "path": "document.pages",
            "length": 1
          },
          {
            "path": "document.pages[0]",
            "equals": {
              "number": 1,
              "width": 612,
              "height": 792,
              "rotate": 0
            }
          },
          {
            "path": "document.digest",
            "equals": {
              "$ctx": "upload_sha256"
            }
          }
        ]
      },
      "basis": [
        {
          "pointer": "#/components/schemas/PageGeometry/description",
          "text": "Displayed page size after applying /Rotate, in PDF points."
        },
        {
          "pointer": "#/paths/~1v1~1envelopes~1{envelope_id}~1document/put/responses/200/description",
          "text": "Document accepted after isolated parsing; page geometry returned for field placement"
        }
      ]
    },
