        },
        "headers": {
          "If-Match": {
            "$ctx": "version_text"
          }
        }
      },
      "defect": {
        "kind": "header-invalid",
        "header": "If-Match"
      },
      "expect": {
        "status": 400,
        "code": "invalid_request"
      },
      "basis": [
        {
          "pointer": "#/components/parameters/IfMatch/schema/pattern",
          "value": "^\"[1-9][0-9]{0,9}\"$"
        },
        {
          "pointer": "#/components/responses/BadRequest/description",
          "text": "invalid_request: malformed JSON, schema violation or unknown property"
        }
      ]
    },
