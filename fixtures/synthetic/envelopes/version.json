{
  "schema": "opensig.envelope-conformance-fixture/1",
  "category": "version",
  "cases": [
    {
      "id": "EC-VER-01",
      "title": "upload with If-Match of the current version is accepted and advances the version",
      "given": "draft-1",
      "request": {
        "operationId": "uploadDocument",
        "path": {
          "envelope_id": {
            "$ctx": "envelope_id"
          }
        },
        "body": {
          "pdf": {
            "pages": 1
          }
        }
      },
      "defect": null,
      "expect": {
        "status": 200,
        "body": [
          {
            "path": "state",
            "equals": "draft"
          },
          {
            "path": "version",
            "greaterThan": {
              "$ctx": "version"
            }
          },
          {
            "path": "document.bytes",
            "equals": {
              "$ctx": "upload_bytes"
            }
          },
          {
            "path": "document.digest",
            "equals": {
              "$ctx": "upload_sha256"
            }
          },
          {
            "path": "document.pages",
            "length": 1
          }
        ]
      },
      "basis": [
        {
          "pointer": "#/components/parameters/IfMatch/description",
          "text": "Expected envelope version as a quoted string"
        },
        {
          "pointer": "#/paths/~1v1~1envelopes~1{envelope_id}~1document/put/responses/200/description",
          "text": "Document accepted after isolated parsing; page geometry returned for field placement"
        }
      ]
    },
    {
      "id": "EC-VER-02",
      "title": "upload without If-Match requires a precondition",
      "given": "draft-1",
      "request": {
        "operationId": "uploadDocument",
        "path": {
          "envelope_id": {
            "$ctx": "envelope_id"
          }
        },
        "body": {
          "pdf": {
            "pages": 1
          }
        },
        "headers": {
          "If-Match": null
        }
      },
      "defect": {
        "kind": "header-missing",
        "header": "If-Match"
      },
      "expect": {
        "status": 428,
        "code": "precondition_required"
      },
      "basis": [
        {
          "pointer": "#/components/responses/PreconditionRequired/description",
          "text": "precondition_required: If-Match missing on upload"
        }
      ]
    },
    {
      "id": "EC-VER-03",
